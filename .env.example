VITE_APP_BG_KEY=

# ImageBB — get a free API key at https://api.imgbb.com/
VITE_IMGBB_API_KEY=""

# ── Backend / Server ──────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pixora?retryWrites=true&w=majority"

JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# GitHub OAuth app — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"
# If the backend doesn't have the same origin as the frontend, set VITE_API_URL to the backend URL (e.g. http://localhost:3001)
VITE_API_URL="http://localhost:3001"

PORT=3001
NODE_ENV="development"
